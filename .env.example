# Use DATABASE_URL on Vercel, or the individual DB_* values locally.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=true

# Required for signed admin and agent session cookies.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

PAYSO_MERCHANT_ID=
PAYSO_API_KEY=
PAYSO_SECRET_KEY=
PAYSO_SANDBOX=true

GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
