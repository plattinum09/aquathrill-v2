# Use DATABASE_URL on Vercel, or the individual DB_* values locally.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=true

# Required for signed admin and agent session cookies.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Omise payment gateway
# Use test keys locally/staging and live keys in production.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Optional: verify webhook signatures if enabled in Omise dashboard.
OMISE_WEBHOOK_SECRET=
# Optional: force Omise return URLs to use the public site instead of localhost.
OMISE_RETURN_BASE_URL=https://www.aquathrill-thailand.com
# Default Omise source. Use promptpay unless a specific mobile banking source is enabled on the Omise account.
# Other examples: mobile_banking_bay, mobile_banking_kbank, mobile_banking_scb.
OMISE_DEFAULT_SOURCE_TYPE=promptpay
# Minimum online booking amount in THB. Keep 20 for Omise test payments; set higher in production if needed.
MIN_ONLINE_BOOKING_AMOUNT=20

GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
